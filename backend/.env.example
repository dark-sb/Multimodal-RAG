# Multimodal RAG Studio Environment Configuration

# Provider selection: "local_extractive", "gemini", or "openai"
LLM_PROVIDER=local_extractive
EMBEDDING_PROVIDER=local

# Optional Cloud API Keys (Leave blank to use the built-in local grounded engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Names
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Document Upload & Ingestion Settings
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5
